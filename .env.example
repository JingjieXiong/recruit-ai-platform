# Safe default: deterministic synthetic outputs, no external AI key required.
AI_MODE=fixture
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_VISION_MODE=off

# Public provider contract. The bundled runtime is a browser-only demo.
INTERVIEW_RUNTIME=browser-demo
INTERVIEW_BASE_URL=http://127.0.0.1:5174
INTERVIEW_PUBLIC_BASE_URL=http://127.0.0.1:5174
INTERVIEW_BRIDGE_PUBLIC_BASE_URL=http://127.0.0.1:5173
INTERVIEW_BRIDGE_CALLBACK_SECRET=local-browser-demo-secret
INTERVIEW_DEFAULT_QUESTION_COUNT=6
INTERVIEW_MAX_FOLLOW_UPS_PER_QUESTION=2

PORT=5173
INTERVIEW_PORT=5174
RUNTIME_MODE=docker
STORAGE_PROVIDER=s3
QUEUE_PROVIDER=redis
VECTOR_PROVIDER=pgvector
RECRUIT_DATA_ROOT=./.runtime/data
DATABASE_URL=postgres://recruit:recruit@127.0.0.1:5432/recruit_ai
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORAGE_ENDPOINT=127.0.0.1
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_ACCESS_KEY=recruit
OBJECT_STORAGE_SECRET_KEY=recruit-password
OBJECT_STORAGE_BUCKET=recruit-ai
OBJECT_STORAGE_USE_SSL=false
ID_HASH_SALT=change-me-before-non-demo-use
